# ================================================================
# Production Docker image for doc-ai-gateway
# 只打包预编译的二进制，不编译
# ================================================================
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY dist/doc-ai-gateway /app/doc-ai-gateway
COPY cfg.yml /app/cfg.yml

# 数据库和数据目录由 volume 挂载提供
RUN mkdir -p /app/data/files

ENV PORT=8080

EXPOSE 8080

ENTRYPOINT ["/app/doc-ai-gateway"]